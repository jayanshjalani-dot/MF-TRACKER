# Angel One SmartAPI Credentials
# NEVER commit the real .env file — add it to .gitignore
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PIN=your_4_digit_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_base32_here

# News API (get free key at newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# Server Config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Rate limiting
MAX_REQUESTS_PER_SECOND=18
